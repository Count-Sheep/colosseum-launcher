diff --git a/tools/unit_cache.py b/tools/unit_cache.py
new file mode 100644
index 0000000..95eb9fa
--- /dev/null
+++ b/tools/unit_cache.py
@@ -0,0 +1,138 @@
+#!/usr/bin/env python3
+"""A cache of what game units compile to, for builds in another folder or of another version.
+
+COLO_UNIT_CACHE names its folder; without it nothing here does anything. An entry's key is a hash of everything
+its result depends on, never of a timestamp or a path:
+* a unit's IR: the unit as preprocessed (so every header it reads counts), its flags, the symbols and arity tables
+  befix.py reads, and the tool id;
+* an object: its rewritten IR and the tool id;
+* the mirror: the decomp's commit, the port's tools and headers, and the tool id.
+The tool id is the compiler's version, the system targeted and the scripts that write these results.
+Compiled results name no path of the build (cflags.py maps them away), so they hold in any folder. Anything that
+goes wrong here counts as a miss: the build then compiles as it would have.
+  unit_cache.py id                 write build/tool-id
+  unit_cache.py restore-mirror     unpack the mirror when it is cached (exit 1 when not)
+  unit_cache.py save-mirror        keep the mirror just made
+"""
+import glob, hashlib, io, os, shlex, subprocess, sys, tarfile
+
+P = (os.environ.get('COLO_PORT') or os.path.dirname(os.path.dirname(os.path.abspath(__file__)))).replace(os.sep, '/')
+DIR = os.environ.get('COLO_UNIT_CACHE')
+ID_FILE = P + '/build/tool-id'
+STATS = P + '/build/unit-cache.log'
+TOOLS = ('befix', 'cc_unit', 'cflags', 'coffasm', 'fix32s', 'unit_cache')
+MIRROR_FILES = ('unit_flags.json', 'skip_units.json', 'fixconf.json')
+
+
+def digest(*parts):
+    h = hashlib.sha256()
+    for part in parts:
+        b = part if isinstance(part, bytes) else str(part).encode()
+        h.update(len(b).to_bytes(8, 'little'))
+        h.update(b)
+    return h.hexdigest()
+
+
+def read(path):
+    try:
+        with open(path, 'rb') as f: return f.read()
+    except OSError:
+        return b''
+
+
+def tool_id(): return read(ID_FILE)
+
+
+def entry(key, suffix): return os.path.join(DIR, key[:2], key + suffix)
+
+
+def count(hit):
+    try:
+        with open(STATS, 'ab') as f: f.write(b'h' if hit else b'm')
+    except OSError:
+        pass
+
+
+def fetch(key, pairs):
+    """pairs: (suffix, destination), all or none. True when the files are in place."""
+    try:
+        for suffix, _ in pairs:
+            if not os.path.isfile(entry(key, suffix)): return False
+        for suffix, dest in pairs:
+            data = read(entry(key, suffix))
+            with open(dest + '.fetch', 'wb') as f: f.write(data)
+            os.replace(dest + '.fetch', dest)
+            os.utime(entry(key, suffix))   # the launcher removes what was used longest ago
+        return True
+    except OSError:
+        return False
+
+
+def store(key, pairs):
+    """written beside its place and renamed in, so a reader never sees half a file"""
+    try:
+        os.makedirs(os.path.dirname(entry(key, '')), exist_ok=True)
+        for suffix, source in pairs:
+            temporary = '%s.%d.tmp' % (entry(key, suffix), os.getpid())
+            with open(temporary, 'wb') as f: f.write(read(source))
+            os.replace(temporary, entry(key, suffix))
+    except OSError:
+        pass
+
+
+def write_id():
+    clang = shlex.split(os.environ.get('COLO_CLANG', 'clang'), posix=True)
+    version = subprocess.run(clang + ['--version'], capture_output=True).stdout
+    # the first line names the compiler: the rest is where this copy of it is
+    parts = [version.split(b'\n')[0], os.environ.get('COLO_TARGET') or sys.platform]
+    parts += [read('%s/tools/%s.py' % (P, name)) for name in TOOLS]
+    text = digest(*parts).encode()
+    if read(ID_FILE) != text:
+        with open(ID_FILE, 'wb') as f: f.write(text)
+
+
+def mirror_key():
+    decomp = os.environ.get('DECOMP', '')
+    commit = subprocess.run(['git', '-C', decomp, 'rev-parse', 'HEAD'], capture_output=True, text=True).stdout.strip()
+    if not commit: return None
+    files = sorted(glob.glob(P + '/tools/*.py') + glob.glob(P + '/tools/*.sh') + glob.glob(P + '/tools/asm_c/**', recursive=True)
+                   + glob.glob(P + '/port_include/**', recursive=True))
+    return digest('mirror', tool_id(), commit, *[x for f in files if os.path.isfile(f) for x in (os.path.relpath(f, P), read(f))])
+
+
+def restore_mirror():
+    if not DIR: return 1
+    key = mirror_key()
+    if not key or not os.path.isfile(entry(key, '.tar')): return 1
+    try:
+        with tarfile.open(entry(key, '.tar')) as tar:
+            tar.extractall(P + '/build', filter='data')
+        os.utime(entry(key, '.tar'))
+    except (OSError, tarfile.TarError):
+        return 1
+    print('mirror: reused')
+    return 0
+
+
+def save_mirror():
+    if not DIR: return 0
+    key = mirror_key()
+    if not key: return 0
+    try:
+        os.makedirs(os.path.dirname(entry(key, '')), exist_ok=True)
+        temporary = '%s.%d.tmp' % (entry(key, '.tar'), os.getpid())
+        with tarfile.open(temporary, 'w') as tar:
+            tar.add(P + '/build/mirror', arcname='mirror')
+            for name in MIRROR_FILES:
+                if os.path.exists(P + '/build/' + name): tar.add(P + '/build/' + name, arcname=name)
+        os.replace(temporary, entry(key, '.tar'))
+    except OSError:
+        pass
+    return 0
+
+
+if __name__ == '__main__':
+    command = sys.argv[1]
+    if command == 'id': write_id()
+    elif command == 'restore-mirror': sys.exit(restore_mirror())
+    elif command == 'save-mirror': sys.exit(save_mirror())
